# FreshMart Local - Environment Variables
# Copy this file to .env.local and fill in your Supabase credentials
# If left empty, the application will automatically run in zero-config demo mode with pre-seeded data!

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
